<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">

    <!-- Define the mirror -->
    <mirrors>
        <mirror>
            <id>nexus-mirror</id>
            <name>Nexus Mirror Repository</name>
            <url>https://192.168.10.10/repository/maven-public/</url>
            <mirrorOf>*</mirrorOf>
        </mirror>
    </mirrors>

    <profiles>
        <profile>
            <id>insecure</id>
            <properties>
                <aether.connector.https.securityMode>insecure</aether.connector.https.securityMode>
            </properties>
        </profile>
    </profiles>

    <activeProfiles>
        <activeProfile>insecure</activeProfile>
    </activeProfiles>

</settings>